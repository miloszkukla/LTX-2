new file mode 100644
index 0000000..e042256
--- /dev/null
+++ b/src/Native/LibTorchSharp/THSLtxAbi.cpp
@@ -0,0 +1,46 @@
+// LTX-specific ABI probe. This file is carried by the LTX TorchSharp fork.
+#include "THSTorch.h"
+#include <ATen/ops/rms_norm.h>
+#include <cuda_runtime_api.h>
+#include <torch/version.h>
+
+EXPORT_API(int32_t) THSLtx_abi_version()
+{
+    return 0x00010000;
+}
+
+EXPORT_API(const char*) THSLtx_torch_version()
+{
+    return TORCH_VERSION;
+}
+
+EXPORT_API(int32_t) THSLtx_cuda_version()
+{
+    return CUDART_VERSION;
+}
+
+EXPORT_API(int32_t) THSLtx_cxx11_abi()
+{
+#if _GLIBCXX_USE_CXX11_ABI
+    return 1;
+#else
+    return 0;
+#endif
+}
+
+EXPORT_API(void) THSLtx_use_math_sdp_only()
+{
+    at::globalContext().setSDPUseFlash(false);
+    at::globalContext().setSDPUseFA3(false);
+    at::globalContext().setSDPUseMemEfficient(false);
+    at::globalContext().setSDPUseMath(true);
+    at::globalContext().setSDPUseCuDNN(false);
+    at::globalContext().setSDPUseOverrideable(false);
+    at::globalContext().setAllowFP16BF16ReductionMathSDP(false);
+}
+
+EXPORT_API(Tensor) THSLtx_rms_norm(const Tensor input, const Tensor weight, const double eps)
+{
+    const std::optional<at::Tensor> normalized_weight = weight == nullptr ? std::nullopt : std::optional<at::Tensor>(*weight);
+    CATCH_TENSOR(at::rms_norm(*input, {input->size(-1)}, normalized_weight, eps));
+}
