# syntax=docker/dockerfile:1.7
# Deliberately source-free. The build context is restricted by .dockerignore.
FROM nvidia/cuda@sha256:293837d7ad950f195e6ba5e3c0478c50b8c80349a70ad14687f39ed8ff0a8e4a

ARG DEBIAN_FRONTEND=noninteractive

LABEL org.opencontainers.image.source="https://github.com/miloszkukla/LTX-2" \
      org.opencontainers.image.description="Source-free CUDA 13.2/.NET 10 bootstrap for the LTX C# port" \
      io.ltx.cuda.image="nvidia/cuda:13.2.0-cudnn-devel-ubuntu24.04" \
      io.ltx.cuda.linux-amd64-digest="sha256:293837d7ad950f195e6ba5e3c0478c50b8c80349a70ad14687f39ed8ff0a8e4a"

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        cmake \
        curl \
        ffmpeg \
        git \
        gnupg \
        jq \
        libavcodec-dev \
        libavfilter-dev \
        libavformat-dev \
        libavutil-dev \
        libgl1 \
        libglib2.0-0 \
        libopenimageio-dev \
        libopencv-dev \
        libswresample-dev \
        libswscale-dev \
        ninja-build \
        openimageio-tools \
        pkg-config \
        python3 \
        python3-dev \
        python3-pip \
        python3-venv \
        skopeo \
        software-properties-common \
        unzip \
    && bootstrap_dir="$(mktemp -d /tmp/ltx-dotnet.XXXXXX)" \
    && curl -fsSLo "${bootstrap_dir}/packages-microsoft-prod.deb" \
        https://packages.microsoft.com/config/ubuntu/24.04/packages-microsoft-prod.deb \
    && dpkg -i "${bootstrap_dir}/packages-microsoft-prod.deb" \
    && apt-get update \
    && apt-get install -y --no-install-recommends dotnet-sdk-10.0 gh \
    && curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR=/usr/local/bin sh \
    && ldconfig \
    && dotnet --info >/dev/null \
    && nvcc --version >/dev/null \
    && ffmpeg -version >/dev/null \
    && oiiotool --help >/dev/null \
    && rm -rf -- "${bootstrap_dir}" \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

ENV DOTNET_CLI_TELEMETRY_OPTOUT=1 \
    DOTNET_NOLOGO=1 \
    NUGET_XMLDOC_MODE=skip \
    PATH="/root/.local/bin:${PATH}"

WORKDIR /work
